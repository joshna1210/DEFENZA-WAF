# ---------- General ----------
ENV=development
BACKEND_PORT=8000
PROXY_PORT=9000
FRONTEND_PORT=5173

# ---------- MongoDB ----------
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ai_waf

# ---------- Proxy target ----------
# The real website/app that traffic should be forwarded to
TARGET_URL=http://localhost:3000

# ---------- ML Engine ----------
ML_MODEL_NAME=distilbert-base-uncased
ML_ENABLED=false
ML_RISK_THRESHOLD=0.75

# ---------- Blockchain ----------
BLOCKCHAIN_ENABLED=false
WEB3_PROVIDER_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
DEPLOYER_PRIVATE_KEY=
BATCH_LOG_INTERVAL_SECONDS=300
BATCH_LOG_SIZE=100

# ---------- Security ----------
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ---------- IP Geolocation (optional) ----------
GEOIP_ENABLED=false
